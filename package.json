{
  "name": "the-daily-web",
  "version": "1.0.0",
  "private": true,
  "description": "The Daily Web - News Management System",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --env-file=.env --watch server.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "test": "node --test tests/*.test.js",
    "preview": "node scripts/preview.js",
    "check": "node scripts/check.js",
    "doctor": "node --env-file=.env scripts/setup-check.js"
  },
  "dependencies": {
    "ejs": "3.1.10",
    "express": "5.1.0",
    "mongoose": "8.19.1"
  }
}
