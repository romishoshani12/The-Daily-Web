</div>
<div class="metrics">
<div>
<span>צפיות בטווח הנבחר</span>
<strong id="range-total">—</strong>
</div>
<div>
<span>צפיות בכל הזמנים</span>
</div>
</div>
</main>
<%- include('partials/footer') %>
