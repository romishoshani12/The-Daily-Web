</label>
<label>כתבה<select id="analytics-article" aria-label="בחירת כתבה">
</select>
</label>
<label>טווח זמן<select id="analytics-days">
<option value="1">24 שעות</option>
<option value="7" selected>7 ימים</option>
<option value="30">30 ימים</option>
</select>
