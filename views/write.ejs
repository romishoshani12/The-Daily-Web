<%- include('partials/head', { sheet: 'staff' }) %>
<%- include('partials/staff-nav') %>
<main id="main" class="staff-main write-main" data-article-id="<%= article.id %>" data-status="<%= article.status %>" data-revision="<%= article.revision %>" data-editor="<%= user.role === 'editor' %>">
<div class="workspace-heading">
<div>
<a class="back-link" href="<%= user.role === 'editor' ? '/editor' : '/reporter' %>">→ סביבת העבודה</a>
<h1>
<%= article.draft.title || 'סיפור חדש מתחיל כאן' %>
</h1>
</div>
<span class="status <%= article.status %>" id="article-status">
<%= stateLabels[article.status] %>
</span>
</div>
<% if (article.editorNote) { %>
<div class="notice">
<strong>הערת העורך</strong>
<p>
<%= article.editorNote %>
</p>
</div>
<% } %>
<div class="write-layout">
<section class="write-surface">
<form id="write-form">
<fieldset <%= article.status === 'pending' && user.role !== 'editor' ? 'disabled' : '' %>>
<label>כותרת<input name="title" value="<%= article.draft.title %>" maxlength="180" placeholder="כותרת שעושה חשק לקרוא" required>
</label>
<label>תקציר<textarea name="summary" rows="3" maxlength="450" placeholder="הסיפור בכמה מילים" required>
<%= article.draft.summary %>
</textarea>
</label>
<div class="form-row">
<label>קטגוריה<select name="category">
<% categories.forEach(category => { %>
<option <%= article.draft.category === category ? 'selected' : '' %>>
<%= category %>
</option>
<% }) %>
</select>
</label>
<label>תמונה ראשית<input name="image" value="<%= article.draft.image %>" dir="ltr" required>
</label>
</div>
<label>תוכן הכתבה<textarea class="body-editor" name="body" rows="18" maxlength="60000" placeholder="כאן מתחיל הסיפור שלכם…" required>
<%= article.draft.body %>
</textarea>
</label>
</fieldset>
</form>
<div class="write-bottom">
<span id="word-count" class="muted">
</span>
<span id="save-state" role="status">כל השינויים שמורים</span>
</div>
<button class="button outline" id="retry-save" hidden>ניסיון שמירה נוסף</button>
</section>
<aside class="write-aside">
<span class="eyebrow">הדרך לפרסום</span>
<h2>עוד רגע,<br>כולם קוראים.</h2>
<p>העבודה נשמרת אוטומטית. רק גרסה שאושרה בידי עורך מוצגת לקוראים.</p>
<% if (article.status !== 'pending') { %>
<button class="button full" id="submit-article" <%= article.status === 'published' ? 'disabled' : '' %>>
<%= article.status === 'returned' ? 'הגשה מחדש לאחר תיקון' : 'שליחה לאישור עורך' %> ←</button>
<% } %>
<% if (article.status === 'published') { %>
<p id="submit-hint">ערכו את הכתבה כדי להכין עדכון חדש לאישור.</p>
<% } %>
<%- include('partials/review-actions', { article }) %>
<% if (article.published) { %>
<a class="button outline full" href="/articles/<%= article.id %>" target="_blank">לגרסה הציבורית ↗</a>
<% } %>
<% if (user.role === 'editor') { %>
<button class="text-button danger" id="delete-article">מחיקת הכתבה</button>
<% } %>
<p id="write-message" role="alert">
</p>
</aside>
</div>
<%- include('partials/published-comparison', { article }) %>
</main>
<script src="/js/write.js" defer>
</script>
<script src="/js/review.js" defer>
</script>
<%- include('partials/footer') %>
