# Copy this file to ".env" and fill in real values. Never commit .env (it's in .gitignore file)
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/daily_web
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
NODE_ENV=development
